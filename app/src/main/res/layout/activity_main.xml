<?xml version="1.0" encoding="utf-8"?>
<!-- 主菜单：顶部强调线 + 顶栏（品牌/账号/退出药丸）+ 图标列表 -->
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zhixue_dark">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:boxedEdges="all">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/screen_pad_h"
            android:paddingRight="@dimen/screen_pad_h"
            android:paddingTop="2dp"
            android:paddingBottom="@dimen/gap_lg">

            <View
                android:id="@+id/accent_line"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/zhixue_blue" />

            <LinearLayout
                android:id="@+id/header_bar"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_brand"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/zhixue_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tv_user"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/not_logged_in"
                        android:textColor="@color/zhixue_grey"
                        android:textSize="9sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_exit"
                    style="@style/Pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exit" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menu_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/menu_row_height" android:id="@+id/btn_marks" style="@style/MenuRow">
                    <ImageView android:layout_width="@dimen/menu_icon_size" android:layout_height="@dimen/menu_icon_size" android:src="@drawable/ic_marks"
                        android:tint="@color/zhixue_grey" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/MenuLabel" android:layout_marginStart="10dp"
                        android:text="@string/marks" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/menu_row_height" android:id="@+id/btn_exams" style="@style/MenuRow">
                    <ImageView android:layout_width="@dimen/menu_icon_size" android:layout_height="@dimen/menu_icon_size" android:src="@drawable/ic_exams"
                        android:tint="@color/zhixue_grey" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/MenuLabel" android:layout_marginStart="10dp"
                        android:text="@string/exams" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/menu_row_height" android:id="@+id/btn_homework" style="@style/MenuRow">
                    <ImageView android:layout_width="@dimen/menu_icon_size" android:layout_height="@dimen/menu_icon_size" android:src="@drawable/ic_homework"
                        android:tint="@color/zhixue_grey" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/MenuLabel" android:layout_marginStart="10dp"
                        android:text="@string/homework" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/menu_row_height" android:id="@+id/btn_messages" style="@style/MenuRow">
                    <ImageView android:layout_width="@dimen/menu_icon_size" android:layout_height="@dimen/menu_icon_size" android:src="@drawable/ic_messages"
                        android:tint="@color/zhixue_grey" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/MenuLabel" android:layout_marginStart="10dp"
                        android:text="@string/messages" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/menu_row_height" android:id="@+id/btn_about" style="@style/MenuRow">
                    <ImageView android:layout_width="@dimen/menu_icon_size" android:layout_height="@dimen/menu_icon_size" android:src="@drawable/ic_about"
                        android:tint="@color/zhixue_grey" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/MenuLabel" android:layout_marginStart="10dp"
                        android:text="@string/about" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/menu_row_height" android:id="@+id/btn_login" style="@style/MenuRow">
                    <ImageView android:layout_width="@dimen/menu_icon_size" android:layout_height="@dimen/menu_icon_size" android:src="@drawable/ic_login"
                        android:tint="@color/zhixue_grey" android:contentDescription="@null" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/MenuLabel" android:layout_marginStart="10dp"
                        android:text="@string/login" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
